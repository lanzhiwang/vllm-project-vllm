      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "Cache of blocks that are used for prefix caching. It caches blocks",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cache of blocks that are used for prefix caching. It caches blocks",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6oTClCgRpd5UULYDRk6Dm",
      "type": "text",
      "x": 729.9831161499023,
      "y": -11636.984718322754,
      "width": 422.699462890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b07",
      "roundness": null,
      "seed": 1410654377,
      "version": 3,
      "versionNonce": 408699561,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "from hash directly to a block or multiple blocks",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from hash directly to a block or multiple blocks",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WySVdQvQEG5syPHWNdXVq",
      "type": "text",
      "x": 786.6130294799805,
      "y": -11601.984718322754,
      "width": 309.43963623046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 1285921383,
      "version": 3,
      "versionNonce": 1551718503,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "(i.e. {block_hash: KVCacheBlocks})",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(i.e. {block_hash: KVCacheBlocks})",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WpwKACH6LVxtpq0ThDgoR",
      "type": "text",
      "x": 610.3832626342773,
      "y": -11566.984718322754,
      "width": 661.899169921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 1843717001,
      "version": 3,
      "versionNonce": 921699721,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "- Mostly block_hash maps to a single KVCacheBlock, and KVCacheBlocks",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Mostly block_hash maps to a single KVCacheBlock, and KVCacheBlocks",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3_ePVuLe7aLpwvFxCGGTf",
      "type": "text",
      "x": 788.0730209350586,
      "y": -11531.984718322754,
      "width": 306.5196533203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 2046014855,
      "version": 3,
      "versionNonce": 1948496775,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "would simply be a KVCacheBlock.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "would simply be a KVCacheBlock.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HIrUxW1h6xlOCIRWnTH0y",
      "type": "text",
      "x": 633.1832504272461,
      "y": -11496.984718322754,
      "width": 616.2991943359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 410094185,
      "version": 3,
      "versionNonce": 399010921,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "- Otherwise, KVCacheBlocks is a dict from {block_id: KVCacheBlock}",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Otherwise, KVCacheBlocks is a dict from {block_id: KVCacheBlock}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZBsjHchtYquFSnQyXfqGH",
      "type": "text",
      "x": 547.0429306030273,
      "y": -11474.484718322754,
      "width": 788.579833984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 152136871,
      "version": 3,
      "versionNonce": 2022812327,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "用于前缀缓存（prefix caching）的块缓存。它将块哈希（hash）直接映射到单个块或多个\n块（即 `{block_hash: KVCacheBlocks}` 结构）",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "用于前缀缓存（prefix caching）的块缓存。它将块哈希（hash）直接映射到单个块或多个块（即 `{block_hash: KVCacheBlocks}` 结构）",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "l8IssSRTzHqZn4gWHz-5_",
      "type": "text",
      "x": 545.4330978393555,
      "y": -11414.484718322754,
      "width": 791.7994995117188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 1552307529,
      "version": 3,
      "versionNonce": 1387329353,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "- 通常情况下，`block_hash` 映射到单个 `KVCacheBlock`，此时 `KVCacheBlocks` 实际上\n就是一个 `KVCacheBlock` 对象。",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 通常情况下，`block_hash` 映射到单个 `KVCacheBlock`，此时 `KVCacheBlocks` 实际上就是一个 `KVCacheBlock` 对象。",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Ioo5AeoO6n3hXWAOPHcT5",
      "type": "text",
      "x": 606.4630966186523,
      "y": -11341.984718322754,
      "width": 669.739501953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1437286343,
      "version": 3,
      "versionNonce": 645119431,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "- 否则，`KVCacheBlocks` 是一个 `{block_id: KVCacheBlock}` 形式的字典。",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 否则，`KVCacheBlocks` 是一个 `{block_id: KVCacheBlock}` 形式的字典。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WpRG4NPGXrVlkNaY-6vEB",
      "type": "text",
      "x": 651.8933029174805,
      "y": -11271.984718322754,
      "width": 578.8790893554688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 494847017,
      "version": 3,
      "versionNonce": 2047157801,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "A cached block is a full block with a block hash that can be used",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A cached block is a full block with a block hash that can be used",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fj858V-8cmsgpZFQIPW92",
      "type": "text",
      "x": 861.1929473876953,
      "y": -11236.984718322754,
      "width": 160.27980041503906,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
