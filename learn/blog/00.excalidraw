      "updated": 1781073356193,
      "link": null,
      "locked": false,
      "text": "class Scheduler(SchedulerInterface):\n\n    self.policy = SchedulingPolicy(self.scheduler_config.policy)\n    self.waiting = create_request_queue(self.policy)\n    self.running: list[Request] = []\n    self.kv_cache_manager = KVCacheManager()",
      "fontSize": 20,
      "fontFamily": 6,
