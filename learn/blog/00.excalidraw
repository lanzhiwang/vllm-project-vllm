      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "in O(1) time. To close the performance gap to the builtin deque which is",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in O(1) time. To close the performance gap to the builtin deque which is",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XQ46zJWFelWDN2jzOil07",
      "type": "text",
      "x": 606.4232711791992,
      "y": -12741.984718322754,
      "width": 669.8191528320312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
