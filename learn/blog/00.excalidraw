    {
      "id": "nUsPVNj790Q4EG7vKuUwz",
      "type": "text",
      "x": 1401.895629035102,
      "y": -14224.117737664114,
      "width": 639.6390380859375,
      "height": 975,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
