      "text": "manipulating the linked list. Instead, this class manipulates the",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "manipulating the linked list. Instead, this class manipulates the",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VYzI4GX5A4NOEFjKSq9v9",
      "type": "text",
      "x": 640.6032333374023,
      "y": -12671.984718322754,
      "width": 601.459228515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
