      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "implemented in C++, this class does not allocate any Python objects when",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "implemented in C++, this class does not allocate any Python objects when",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QyPNz85XRA6Q2VWj19efZ",
      "type": "text",
      "x": 657.6432723999023,
      "y": -12706.984718322754,
      "width": 567.379150390625,
      "height": 25,
