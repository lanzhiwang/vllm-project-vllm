      "isDeleted": true,
      "boundElements": null,
      "updated": 1781070968242,
      "link": null,
      "locked": false,
      "text": "The cached block may be used by running requests or in the",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The cached block may be used by running requests or in the",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JDY1R1Xn14u3D6FASAhSy",
      "type": "text",
      "x": 711.583122253418,
